# Application
APP_NAME="OptiCare Glaucoma Screening"
APP_ENV=production
SECRET_KEY=change-this-secret-key
DATABASE_PATH=data/eyecare.db
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
RAG_DOCS_DIR=data/rag_docs

# Backend / Frontend
API_BASE_URL=http://127.0.0.1:8000

# Glaucoma model integration
# Options: disabled, external_api, local_torch
# disabled: image upload is stored but automated prediction is not produced.
# external_api: FastAPI calls your independent model server.
# local_torch: load a PyTorch checkpoint from MODEL_PATH after you implement build_model() in backend/services/model_service.py.
MODEL_BACKEND=local_torch
MODEL_PATH=models/resnet50_glaucoma_state_dict.pt
MODEL_DEVICE=auto
MODEL_THRESHOLD_HIGH=0.4764453165475008
MODEL_THRESHOLD_UNCERTAIN=0.1764453165475008
MODEL_API_URL=http://127.0.0.1:9000/predict
MODEL_API_KEY=

# Optional LLM provider for the RAG assistant.
# The assistant uses an OpenAI Chat Completions compatible HTTP adapter.
# Leave disabled for retrieval-only answers.
#
# DeepSeek:
#   LLM_PROVIDER=deepseek
#   LLM_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_API_KEY=your_deepseek_key_here
#   LLM_MODEL=deepseek-v4-flash
#
# Groq:
#   LLM_PROVIDER=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   GROQ_API_KEY=your_groq_key_here
#   LLM_MODEL=put_the_model_id_from_your_groq_dashboard_here
#
# LLM_API_KEY remains available as a generic fallback for other
# OpenAI-compatible providers.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=500

# Local OCR for RAG PDF uploads
# PDF files are always rendered page-by-page and processed locally with Tesseract.
OCR_PROVIDER=local_tesseract
OCR_DPI=220
OCR_JPEG_QUALITY=90
OCR_MAX_PDF_PAGES=50
OCR_LANGUAGES=ara+eng
OCR_TESSERACT_CONFIG=--oem 3 --psm 6 -c preserve_interword_spaces=1
OCR_PREPROCESS=true
OCR_TESSERACT_CMD=

# Text processing for RAG ingestion
TEXT_NORMALIZATION_LEVEL=standard
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_TOP_K=4
RAG_RETRIEVAL_ANALYZER=char_wb

# Local semantic RAG retrieval
# Uses local multilingual embeddings + FAISS vector index.
RAG_RETRIEVAL_MODE=embedding
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_DEVICE=cpu
VECTOR_INDEX_DIR=data/vector_index
RAG_MIN_SCORE=0.18
RAG_REBUILD_ON_QUERY=true
# Load local embedding/reranker models during backend startup so the first chat request stays fast.
RAG_WARMUP_ON_STARTUP=true

# Local vector store backend
# numpy is safer on macOS/Apple Silicon than faiss-cpu.
VECTOR_STORE_BACKEND=chroma
CHROMA_DB_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=eyecare_rag_chunks
RAG_CANDIDATE_K=12
RERANKER_MODE=cross_encoder
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_LOCAL_FILES_ONLY=false
RERANKER_DEVICE=cpu
RERANKER_TOP_N=4
RERANKER_BATCH_SIZE=4
